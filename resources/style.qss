/* Windows 11 Task Manager visual approximation (light theme). */

* {
    font-family: "Segoe UI Variable Text", "Segoe UI", "Ubuntu", "Cantarell", "Noto Sans", sans-serif;
}

QMainWindow, QWidget#centralWidget {
    background: #f3f3f3;
}

#navigationSidebar {
    background: #f3f3f3;
    border: none;
    border-right: 1px solid #e5e5e5;
    outline: none;
    padding: 8px 8px;
}

#navigationSidebar::item {
    height: 34px;
    padding-left: 12px;
    border-radius: 4px;
    margin: 1px 0px;
    color: #1a1a1a;
    border-left: 3px solid transparent;
}

#navigationSidebar::item:selected {
    background: #ffffff;
    border-left: 3px solid #0078d4;
    color: #000000;
    font-weight: 600;
}

#navigationSidebar::item:hover:!selected {
    background: rgba(0, 0, 0, 18);
}

QStackedWidget {
    background: #ffffff;
}

QTableView {
    background: #ffffff;
    border: none;
    gridline-color: transparent;
    alternate-background-color: #fafafa;
    selection-background-color: #cce4f7;
    selection-color: #000000;
}

QTableView::item {
    padding: 2px 6px;
    border-bottom: 1px solid #f0f0f0;
}

QTableView::item:hover {
    background: #f5f5f5;
}

QTableView::item:selected {
    background: #cce4f7;
    color: #000000;
}

QHeaderView::section {
    padding: 8px 6px;
    border: none;
    border-bottom: 1px solid #e5e5e5;
    background: #f9f9f9;
    color: #5f5f5f;
    font-weight: 600;
}

QHeaderView::section:hover {
    background: #f0f0f0;
}

QPushButton {
    background: #ffffff;
    border: 1px solid #d1d1d1;
    border-radius: 4px;
    padding: 6px 14px;
    color: #1a1a1a;
}

QPushButton:hover {
    background: #f5f5f5;
    border-color: #0078d4;
}

QPushButton:pressed {
    background: #e5e5e5;
}

QListWidget {
    background: #ffffff;
    border: 1px solid #e5e5e5;
}

QLabel {
    color: #1a1a1a;
}

QScrollBar:vertical {
    background: transparent;
    width: 12px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #c8c8c8;
    border-radius: 5px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background: #a6a6a6;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}
